<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/skill_course_preflight_map_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/rounded_rect"
    android:backgroundTint="#161622"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/skill_course_preflight_map_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFF"
            android:textSize="13sp"
            tools:text="#1 Example Artist - Example Song [Course Difficulty]" />

        <Button
            android:id="@+id/skill_course_preflight_map_select_mods"
            style="@style/button_borderless"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/skill_course_preflight_select_mods"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/skill_course_preflight_map_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingRight="4dp"
        android:textColor="#FFB2B2CC"
        android:textSize="11sp"
        tools:text="Example Mapper · 16 objects" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/skill_course_preflight_map_required"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingRight="4dp"
            android:textColor="#FF8C8CB4"
            android:textSize="11sp"
            tools:text="Required: HD" />

        <TextView
            android:id="@+id/skill_course_preflight_map_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:textColor="#FF8C8CB4"
            android:textSize="11sp"
            tools:text="Selected: DT" />
    </LinearLayout>

    <TextView
        android:id="@+id/skill_course_preflight_map_effective"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:textColor="#FFB2B2CC"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Effective: HD, DT"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/skill_course_preflight_map_speed_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/skill_course_preflight_speed"
            android:textColor="#FFB2B2CC"
            android:textSize="12sp" />

        <Button
            android:id="@+id/skill_course_preflight_map_speed_minus"
            style="@style/button_borderless"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/skill_course_preflight_speed_decrease"
            android:gravity="center"
            android:padding="0dp"
            android:text="@string/skill_course_preflight_speed_decrease_symbol"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/skill_course_preflight_map_speed_input"
            style="@style/editText"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:imeOptions="actionDone|flagNoFullscreen|flagNoExtractUi"
            android:inputType="numberDecimal"
            android:maxLength="6"
            android:minHeight="48dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textSize="14sp"
            tools:text="1.00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:text="@string/skill_course_preflight_speed_suffix"
            android:textColor="#FFB2B2CC"
            android:textSize="13sp" />

        <Button
            android:id="@+id/skill_course_preflight_map_speed_plus"
            style="@style/button_borderless"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/skill_course_preflight_speed_increase"
            android:gravity="center"
            android:padding="0dp"
            android:text="@string/skill_course_preflight_speed_increase_symbol"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/skill_course_preflight_map_speed_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:text="@string/skill_course_preflight_speed_invalid"
        android:textColor="#FFFFBFBF"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
